# NEO PULSE HUB - Environment Variables Template
# Copy this file to .env and fill in your actual keys

# Database
DATABASE_URL=mysql://user:password@host:port/database

# Telegram Bots
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_id
CUSTOMER_BOT_TOKEN=your_customer_bot_token_here
ADMIN_BOT_TOKEN=your_admin_bot_token_here
SUPPLIER_BOT_TOKEN=your_supplier_bot_token_here
RECO_BOT_TOKEN=your_reco_bot_token_here
ADMIN_USER_ID=your_telegram_user_id

# AI Services
OPENAI_API_KEY=your_openai_key_here
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
GOOGLE_API_KEY=your_google_cloud_api_key_here
GOOGLE_CX=your_google_custom_search_engine_id

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=casperblac991/neo-pulse-hub

# API Security
API_SECRET=choose_a_strong_secret_for_webhooks
ADMIN_API_KEY=choose_a_strong_admin_key

# Store Info
SITE_URL=https://neo-pulse-hub.it.com
AMAZON_AFFILIATE_TAG=neopulsehub-20

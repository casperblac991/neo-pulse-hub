# NEO PULSE HUB - Environment Variables
# Copy this file to .env and fill in your values

# Telegram Bot Token (get from @BotFather)
CUSTOMER_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Google Gemini API Key (for AI responses)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Store URL
SITE_URL=https://neo-pulse-hub.it.com

# Amazon Affiliate Tag
AMAZON_AFFILIATE_TAG=neopulsehub-20

# Admin User ID (your Telegram user ID)
ADMIN_USER_ID=123456789

# Database URL (optional - for production)
# DATABASE_URL=mysql://user:pass@localhost:3306/neopulse